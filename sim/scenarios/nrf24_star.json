    { "id": 2, "pos": [8, 3], "device": "arduino-nrf24l01p", "stack": "nrf24-esb",
      "config": { "send_to": "0xE7E7E7E701", "listen": 0, "send_every_ms": 2000, "jitter_ms": 200 } },
    { "id": 3, "pos": [-6, 9], "device": "arduino-nrf24l01p", "stack": "nrf24-esb",
      "config": { "send_to": "0xE7E7E7E701", "listen": 0, "send_every_ms": 2000, "jitter_ms": 200 } },
    { "id": 4, "pos": [-12, -4], "device": "arduino-nrf24l01p", "stack": "nrf24-esb",
      "config": { "send_to": "0xE7E7E7E701", "listen": 0, "send_every_ms": 2000, "jitter_ms": 200 } },
    { "id": 5, "pos": [4, -15], "device": "arduino-nrf24l01p", "stack": "nrf24-esb",
      "radio": { "tx_power_dbm": -6 },
